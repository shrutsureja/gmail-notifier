{
  "$description": "Gmail Notifier design tokens. Matches Ubuntu's dark top bar (GNOME / Yaru dark). Used by the mockups in design/mockups and the icons in gmail_notifier/icons.",
  "color": {
    "topbar":        {"value": "#000000", "use": "GNOME top bar behind the tray icon"},
    "surface":       {"value": "#2b2b2b", "use": "menu and notification background"},
    "surface-hover": {"value": "#3b3b3b", "use": "hovered / expanded menu row"},
    "border":        {"value": "#424242", "use": "menu border and separators"},
    "text":          {"value": "#f2f2f2", "use": "primary text"},
    "text-muted":    {"value": "#b5b5b5", "use": "headers, emails, timestamps (6.9:1 on surface)"},
    "accent":        {"value": "#e95420", "use": "Ubuntu orange: toggles and focus rings only, never body text"},
    "link":          {"value": "#f6a27f", "use": "'Open inbox in browser' and other links"},
    "unread-dot":    {"value": "#ea4335", "use": "red dot on the tray icon when there is unread mail"},
    "warning-dot":   {"value": "#fbbc04", "use": "yellow dot on the tray icon when an account can't log in"},
    "warning-text":  {"value": "#fdd663", "use": "error text in the menu"}
  },
  "category": {
    "primary":    {"value": "#8ab4f8", "title": "Primary"},
    "updates":    {"value": "#fdd663", "title": "Updates", "note": "Gmail 'Forums' is folded into Updates"},
    "social":     {"value": "#81c995", "title": "Social"},
    "promotions": {"value": "#f28b82", "title": "Promotions"}
  },
  "type": {
    "family":      {"value": "Ubuntu, 'Segoe UI', system-ui, sans-serif"},
    "family-mono": {"value": "'Ubuntu Mono', ui-monospace, monospace", "use": "relative times (12m, 2h)"},
    "size-body":   {"value": "14px"},
    "size-small":  {"value": "13px"},
    "size-label":  {"value": "11px", "letterSpacing": "0.08em", "transform": "uppercase", "use": "LATEST, PRIMARY · 2"},
    "size-title":  {"value": "15px", "weight": 700, "use": "notification title"}
  },
  "space": {
    "menu-row-height": {"value": "32px"},
    "menu-row-padding": {"value": "0 14px"},
    "menu-width": {"value": "460px"},
    "notification-width": {"value": "440px"},
    "radius-menu": {"value": "14px"},
    "radius-row": {"value": "8px"},
    "radius-notification": {"value": "16px"}
  },
  "icon": {
    "tray-read":   {"file": "gmail_notifier/icons/gmail-notifier-read.svg"},
    "tray-unread": {"file": "gmail_notifier/icons/gmail-notifier-unread.svg"},
    "tray-error":  {"file": "gmail_notifier/icons/gmail-notifier-error.svg"},
    "app":         {"file": "gmail_notifier/icons/gmail-notifier.svg"}
  }
}
